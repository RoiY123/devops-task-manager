# Example values for local validation and documentation only.
# Production .env.prod is generated automatically from AWS SSM Parameter Store plus deployment-specific values.

# The application's limited database user. Migrations use MIGRATION_DATABASE_URL,
# read during deployment and never written to .env.prod.
DATABASE_URL=postgresql+psycopg://task_manager_app:APP_DB_PASSWORD@RDS_ENDPOINT:5432/task_manager?sslmode=require

JWT_SECRET_KEY=example-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

ENABLE_DOCS=false

IMAGE_TAG=latest