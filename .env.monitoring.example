# Example values for local validation and documentation only.
# Production .env.monitoring is generated automatically during deployment.
# APP_PRIVATE_IP comes from AWS EC2 discovery.
# Monitoring credentials come from AWS SSM Parameter Store.

APP_PRIVATE_IP=10.0.0.10

ALERT_EMAIL=example@gmail.com
ALERT_SMTP_PASSWORD=example-app-password

GRAFANA_ADMIN_PASSWORD=example-grafana-admin-password